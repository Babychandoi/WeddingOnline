{
  "name": "dam-cuoi-online",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "npm --workspace=@dco/shared run test",
    "typecheck": "turbo run typecheck",
    "assets:glb": "node scripts/generate-glb-assets.mjs",
    "assets:venues": "node scripts/render-venue-thumbnails.mjs",
    "check:golive": "node scripts/check-go-live.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "secrets:rotate": "node scripts/rotate-secrets.mjs",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f infra/docker-compose.dev.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker-compose.dev.yml logs -f",
    "db:push": "npm --workspace=@dco/database run db:push",
    "db:seed": "npm --workspace=@dco/database run seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}