# Database & Cache
POSTGRES_USER=dco_admin
POSTGRES_PASSWORD=change_me_strong_pg_password
POSTGRES_DB=damcuoionline
DATABASE_URL=postgresql://dco_admin:change_me_strong_pg_password@postgres:5432/damcuoionline
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_URL=redis://:change_me_strong_redis_password@redis:6379

# App URLs & Google-Only OAuth 2.0
# Authorized redirect URI: https://damcuoionline.vn/api/auth/oauth/google
NEXT_PUBLIC_APP_URL=https://damcuoionline.vn
NEXTAUTH_URL=https://damcuoionline.vn
SESSION_SECRET=generate_strong_session_secret_at_least_32_chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LiveKit Self-Hosted SFU (HTTPS/WSS required for mobile WebRTC)
LIVEKIT_URL=wss://lk.damcuoionline.vn
LIVEKIT_API_KEY=lk_prod_key
LIVEKIT_API_SECRET=generate_strong_livekit_secret_at_least_32_chars

# Platform Admin
# Bank account for plan payments, SePay webhook key and Cloudflare R2 are set in
# the web UI at https://damcuoionline.vn/admin/settings (stored encrypted in the database).
# PLATFORM_ADMIN_EMAILS: Google emails allowed into /admin (comma-separated; restart web after editing)
PLATFORM_ADMIN_EMAILS=
# Encrypts secrets saved from /admin/settings. Generate once (npm run secrets:rotate) and NEVER
# change it afterwards — secrets already saved in the admin page would have to be re-entered.
SETTINGS_ENCRYPTION_KEY=generate_strong_settings_key_at_least_32_chars

# Internal Service Secret & Realtime Endpoints
INTERNAL_SERVICE_SECRET=generate_strong_internal_secret
REALTIME_HTTP_URL=http://realtime:2567
NEXT_PUBLIC_COLYSEUS_URL=wss://damcuoionline.vn/colyseus

# ── Local Docker stack (npm run docker:up → infra/docker-compose.dev.yml) ──
# Passwords for the bundled Postgres / Redis containers (bound to 127.0.0.1 only)
DCO_POSTGRES_PASSWORD=change_me_strong_pg_password
DCO_REDIS_PASSWORD=change_me_strong_redis_password
# LiveKit: copy infra/livekit.dev.yaml.example to infra/livekit.dev.yaml and put
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET from this file into its `keys:` block.
